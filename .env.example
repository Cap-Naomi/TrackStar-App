# Optional: replace the included public demo client ID with your own Spotify app.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=81903a11e1284ca0a5215a98be9e1108

# Optional override for a deployed web app. Leave this unset for native builds
# (which use trackstar-spotify://callback) and local web development (which uses
# the current origin's /callback route).
# EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=https://example.com/callback
